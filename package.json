{
  "name": "wordmem",
  "version": "1.0.0",
  "description": "工作术语知识卡片 PWA",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.cjs",
    "api": "node server/api.cjs",
    "build": "tsc --noEmit && vite build",
    "serve": "npm run build && node server/serve.cjs",
    "preview:mobile": "npm run build && HOST=0.0.0.0 WORDMEM_PRINT_MOBILE_URLS=1 node server/serve.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build"
  },
  "keywords": [
    "pwa",
    "vocabulary",
    "knowledge-cards"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^4.8.2",
    "@capacitor/core": "^4.8.2",
    "katex": "^0.16.9",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^8.0.7",
    "rehype-katex": "^6.0.3",
    "rehype-raw": "^6.1.1",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^4.8.2",
    "@types/react": "^18.0.38",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^1.3.2",
    "typescript": "^4.9.5",
    "vite": "^2.9.16"
  }
}
